  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "弹窗、抽屉和生产任务中的唯一主操作。",
      "html": "<button class=\"ds-btn-primary\">开始导出</button>",
      "css": ".ds-btn-primary{height:34px;padding:0 12px;border:1px solid #3bd5aa;border-radius:4px;background:#3bd5aa;color:#06271f;font:600 11px MiSans,'Microsoft YaHei UI',sans-serif;transition:background 120ms,border-color 120ms}.ds-btn-primary:hover,.ds-btn-primary:focus-visible{background:#67e6c1;border-color:#67e6c1;outline:none}.ds-btn-primary:active{background:#28b88f}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "保留上下文的普通命令和取消操作。",
      "html": "<button class=\"ds-btn-secondary\">取消</button>",
      "css": ".ds-btn-secondary{height:34px;padding:0 12px;border:1px solid #3b474a;border-radius:4px;background:#1a2022;color:#f3f6f5;font:600 11px MiSans,'Microsoft YaHei UI',sans-serif;transition:background 120ms,border-color 120ms}.ds-btn-secondary:hover{background:#293235}.ds-btn-secondary:focus-visible{border-color:#67e6c1;outline:none}.ds-btn-secondary:active{background:#20272a}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "标准单行输入，焦点只改变边界。",
      "html": "<input class=\"ds-input\" value=\"image_{number:04d}\" aria-label=\"文件名模板\">",
      "css": ".ds-input{height:30px;padding:0 9px;border:1px solid #3b474a;border-radius:4px;background:#20272a;color:#f3f6f5;font:400 11px MiSans,'Microsoft YaHei UI',sans-serif}.ds-input:hover{border-color:#536063}.ds-input:focus-visible{border-color:#67e6c1;outline:none}.ds-input::placeholder{color:#84918c}"
    },
    {
      "name": "Icon Button",
      "kind": "button",
      "refersTo": "icon-button",
      "description": "工具栏中的 32px 语义图标命令。",
      "html": "<button class=\"ds-icon-btn\" aria-label=\"保存\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2Z\"/><path d=\"M17 21v-8H7v8M7 3v5h8\"/></svg></button>",
      "css": ".ds-icon-btn{width:32px;height:32px;padding:0;border:0;border-radius:4px;background:transparent;color:#aab5b1;display:grid;place-items:center;transition:background 120ms,color 120ms}.ds-icon-btn svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.ds-icon-btn:hover{background:#293235;color:#f3f6f5}.ds-icon-btn:focus-visible{outline:1px solid #67e6c1;outline-offset:-1px}.ds-icon-btn:active{background:#20272a}"
    },
    {
      "name": "Segmented Control",
      "kind": "custom",
      "description": "2-4 个短标签模式的等宽互斥选择。",
      "html": "<div class=\"ds-segmented\" role=\"tablist\"><button class=\"ds-segment is-active\">绑定组</button><button class=\"ds-segment\">尺寸匹配</button></div>",
      "css": ".ds-segmented{height:30px;padding:2px;border:1px solid #2b3437;border-radius:4px;background:#20272a;display:flex;gap:2px}.ds-segment{flex:1;border:0;border-radius:3px;background:transparent;color:#aab5b1;font:400 10px MiSans,'Microsoft YaHei UI',sans-serif}.ds-segment:hover{background:#293235}.ds-segment:focus-visible{outline:1px solid #67e6c1}.ds-segment.is-active{border:1px solid #28b88f;background:#17352e;color:#3bd5aa;font-weight:600}"
    },
    {
      "name": "Layer Row",
      "kind": "custom",
      "description": "固定 56px 的图层列表行，选中态由底色与强调线共同表达。",
      "html": "<div class=\"ds-layer-row is-selected\"><span class=\"ds-eye\">●</span><span class=\"ds-thumb\">T</span><span class=\"ds-layer-copy\"><strong>限量腕表</strong><small>文字</small></span><span class=\"ds-lock\">▣</span></div>",
      "css": ".ds-layer-row{height:56px;padding:0 10px;border-left:2px solid transparent;background:#151a1c;color:#aab5b1;display:flex;align-items:center;gap:10px;font-family:MiSans,'Microsoft YaHei UI',sans-serif}.ds-layer-row.is-selected{border-left-color:#3bd5aa;background:#17352e}.ds-thumb{width:34px;height:34px;border:1px solid #3b474a;border-radius:4px;background:#20272a;display:grid;place-items:center;color:#3bd5aa}.ds-layer-copy{min-width:0;display:grid;gap:3px;flex:1}.ds-layer-copy strong{color:#f3f6f5;font-size:11px}.ds-layer-copy small{color:#84918c;font-size:9px}.ds-eye,.ds-lock{font-size:10px;color:#aab5b1}"
    },
    {
      "name": "Status Banner",
      "kind": "custom",
      "description": "在当前任务中常驻展示运行、成功或失败状态。",
      "html": "<div class=\"ds-status\"><span class=\"ds-status-dot\"></span><span><strong>配置导出任务</strong><small>等待开始</small></span></div>",
      "css": ".ds-status{min-height:48px;padding:0 12px;border:1px solid #2b3437;border-radius:4px;background:#1a2022;color:#f3f6f5;display:flex;align-items:center;gap:10px;font-family:MiSans,'Microsoft YaHei UI',sans-serif}.ds-status-dot{width:8px;height:8px;border:2px solid #3bd5aa;border-radius:50%}.ds-status span:last-child{display:grid;gap:3px}.ds-status strong{font-size:11px}.ds-status small{color:#84918c;font-size:9px}"
    }
  ],
  "narrative": {
    "northStar": "生产控制台",
    "overview": "批图王不是展示型设计软件，而是长时间、高频率使用的电商图片生产工作台。视觉系统以深色设备控制台为参照：层级清楚、信息紧凑、反馈直接，画布与任务结果始终比界面装饰更重要。品牌存在于精准的生产绿、统一的 Lucide 线性图标和稳定的状态语言中，不依赖渐变、发光或大面积装饰。界面采用 Operate 模式，高频命令一步可达，复杂能力渐进呈现。",
    "keyCharacteristics": ["高密度、低干扰，适合连续生产。", "画布优先，侧栏与弹层不抢夺作品注意力。", "单一生产绿承担主操作、选中与进度语义。", "依靠色阶与 1 px 边界建立层级，不使用装饰阴影。", "全部图标来自统一的 Lucide 语义注册表。", "1180 × 720 到 1600 × 960 之间保持任务完整可达。"],
    "rules": [
      { "name": "The One Accent Rule", "body": "同一视图只有生产绿可表示主操作；状态色只表达状态，不能与主操作竞争。", "section": "colors" },
      { "name": "The Meaning Beyond Color Rule", "body": "任何状态都必须同时提供文字、图标或位置上下文，不能只靠颜色传达。", "section": "colors" },
      { "name": "The Compact Type Rule", "body": "工具界面不使用 hero 级字号；层级优先来自字重、间距和表面位置。", "section": "typography" },
      { "name": "The Zero Tracking Rule", "body": "所有界面文字字距为 0，不使用负字距，也不随窗口宽度缩放字号。", "section": "typography" },
      { "name": "The Canvas Priority Rule", "body": "侧栏不得用固定总宽度挤出横向滚动，任何弹层都不得遮断其自身的完成路径。", "section": "layout" },
      { "name": "The Flat Production Rule", "body": "静止表面保持平坦；只有弹层边界、遮罩和交互状态负责建立层级。", "section": "elevation" }
    ],
    "dos": ["Do 让当前文档、选中对象、修改状态和导出状态持续可见。", "Do 优先复用 AppButton、AppIcon、IconButton、输入、分段、菜单、弹窗和抽屉组件。", "Do 在 1180 × 720、1280 × 760、1600 × 960 以及 Windows 125%/150% 缩放下检查完整任务路径。", "Do 为所有纯图标按钮、开关和模式控件提供可访问名称与可见键盘焦点。", "Do 保持高频命令一步可达，把高级能力放在正确的上下文中渐进展开。"],
    "donts": ["Don't 在业务 QML 中新增界面色十六进制字面量或直接图标资源路径。", "Don't 使用 Unicode 图标、Emoji、渐变装饰、玻璃模糊、发光边缘或大圆角卡片。", "Don't 把页面区段包装成卡片，也不要嵌套卡片。", "Don't 为视觉统一改变 ViewModel、快捷键、.cmp 格式、渲染或导出契约。", "Don't 让弹层内容在最小窗口下遮挡输入、错误说明或最终操作。"]
  }
}
